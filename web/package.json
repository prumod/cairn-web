{
  "name": "@cairn/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "wireframe": "vite --config vite.wireframe.config.ts",
    "wireframe:build": "vite build --config vite.wireframe.config.ts",
    "start": "node .output/server/index.mjs",
    "migrate": "node --import tsx src/server/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "nitro": "3.0.260903-beta",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
