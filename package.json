{
  "name": "cairn-web",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "update": "bash scripts/update.sh",
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "preview": "bun run --cwd web preview",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tsconfig.checks.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "audit": "bun audit",
    "test": "bash scripts/test.sh",
    "test:fast": "node scripts/run-tests.mjs fast",
    "test:browser": "node scripts/run-tests.mjs browser",
    "check": "bash scripts/check.sh full"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.15.30",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.81.0",
    "playwright-bdd": "9.2.1",
    "typescript": "^5.8.3",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.3.14"
}
