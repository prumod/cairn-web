{
  "name": "cairn-web",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "setup": "bun install",
    "update": "bun install",
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "preview": "bun run --cwd web preview",
    "typecheck": "bun run --cwd web typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.81.0"
  },
  "packageManager": "bun@1.3.14"
}
