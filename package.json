{
  "name": "cairn-web",
  "private": true,
  "workspaces": [
    "web",
    "backend"
  ],
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "update": "bash scripts/update.sh",
    "dev": "bun run --cwd web dev",
    "dev:backend": "bun run --cwd backend dev",
    "build": "bun run --cwd web build && bun run --cwd backend build",
    "start": "bun run --cwd backend start",
    "db:migrate": "bun run --cwd backend migrate",
    "preview": "bun run --cwd web preview",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p tsconfig.checks.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "test:boundaries": "node scripts/prove-boundaries.mjs",
    "audit": "bun audit",
    "test": "bash scripts/test.sh",
    "test:fast": "node scripts/with-test-postgres.mjs node scripts/run-tests.mjs fast",
    "test:browser": "node scripts/run-tests.mjs browser",
    "check": "bash scripts/check.sh full"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.15.30",
    "dependency-cruiser": "18.5.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.81.0",
    "playwright-bdd": "9.2.1",
    "tsx": "4.23.15",
    "typescript": "^5.8.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "packageManager": "bun@1.3.14"
}
