{
  "name": "cairn-web",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "better-auth": "1.7.12",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "update": "bash scripts/update.sh",
    "dev": "bun run --cwd packages/infra dev",
    "dev:db": "docker compose -f compose.dev.yaml up -d --wait --wait-timeout 180 && DATABASE_URL=postgres://postgres:local-dev-only@127.0.0.1:54320/cairn bun run db:migrate",
    "build": "bun run --cwd apps/web build",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "bun run env:generate",
    "typecheck": "bun run env:generate && bun run --filter '*' check-types && tsc --noEmit -p tsconfig.checks.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "check:transcriptions": "bun test scripts/transcriptions-pending.test.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "test:boundaries": "node scripts/prove-boundaries.mjs",
    "audit": "bun audit",
    "test": "bash scripts/test.sh",
    "test:fast": "bun run build && bun run test:fast:run",
    "test:fast:run": "node scripts/with-test-postgres.mjs node scripts/run-tests.mjs fast",
    "test:browser": "bun run build && bun run test:browser:run",
    "test:browser:run": "node scripts/run-tests.mjs browser",
    "check": "bash scripts/check.sh full",
    "checks:timings": "node scripts/check-timings.mjs"
  },
  "devDependencies": {
    "@cairn/config": "workspace:*",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.20",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "18.7.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright-bdd": "9.2.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "varlock": "catalog:",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "lodash": "4.18.1",
    "valibot": "1.5.0"
  },
  "packageManager": "bun@1.3.14"
}
