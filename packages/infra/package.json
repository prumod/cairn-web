    "destroy:production": "bun node_modules/alchemy/bin/cli.js destroy --stage production"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cairn/config": "workspace:*",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
