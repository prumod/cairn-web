flowchart LR

    %% =========================
    %% CONTEXTO CONCURSOS
    %% =========================
    subgraph BC1["BC: Concursos Públicos"]
        C["🔷 AR: Concurso<br/><br/>• Entidade adjudicante<br/>• Descrição<br/>• Prazo<br/>• Estado<br/>• Convite"]
    end

    %% =========================
    %% CONTEXTO PROPOSTAS
    %% =========================
    subgraph BC2["BC: Preparação de Propostas"]
        P["🔷 AR: Proposta<br/><br/>• Valor proposto<br/>• Estado<br/>• Data limite"]

        D["◽ Documento<br/>• identificação<br/>• ficheiro<br/>• obrigatório?"]

        MM["◽ Mapa de Medições"]

        CF["◽ Cronograma Financeiro"]

        P --- D
        P --- MM
        P --- CF
    end

    %% =========================
    %% FORNECEDORES
    %% =========================
    subgraph BC3["BC: Compras / Orçamentação"]
        PC["🔷 AR: Processo de Cotação<br/><br/>• Material/serviço<br/>• Estado<br/>• Data"]

        CT["◽ Cotação<br/>• Preço<br/>• Validade<br/>• Condições"]

        F["🔷 AR: Fornecedor<br/><br/>• Nome<br/>• Contactos<br/>• Produtos/serviços"]

        PC --- CT
        CT -. pertence a .-> F
    end

    %% =========================
    %% OBRA
    %% =========================
    subgraph BC4["BC: Gestão da Obra — CORE DOMAIN"]
        O["🔷 AR: Obra<br/><br/>• Valor adjudicado<br/>• Data início<br/>• Prazo<br/>• Estado<br/>• Custos"]
    end

    %% =========================
    %% STOCK
    %% =========================
    subgraph BC5["BC: Materiais / Stock"]
        S["🔷 AR: Inventário / Stock"]

        M["◽ Item de Stock<br/>• Material<br/>• Quantidade"]

        S --- M
    end

    %% =========================
    %% PLANEAMENTO
    %% =========================
    subgraph BC6["BC: Planeamento da Obra"]
        CR["🔷 AR: Cronograma"]

        T["◽ Tarefa<br/>• início<br/>• duração<br/>• estado"]

        DEP["◽ Dependência<br/>• tarefa anterior<br/>• espera<br/>• entrega"]

        CR --- T
        T --- DEP
    end

    %% =========================
    %% RECURSOS HUMANOS
    %% =========================
    subgraph BC7["BC: Recursos"]
        AF["🔷 AR: Afetação de Recursos"]

        FUNC["◽ Funcionário<br/>• identificação<br/>• custo"]

        AF --- FUNC
    end

    %% =========================
    %% PÓS OBRA
    %% =========================
    subgraph BC8["BC: Pós-Obra"]
        G["🔷 AR: Garantia da Obra"]

        V["◽ Vistoria"]
        R["◽ Retenção Financeira"]

        G --- V
        G --- R
    end


    %% =========================
    %% FLUXO ENTRE AGREGADOS
    %% =========================

    C -->|"Evento:<br/>ConcursoSelecionado"| P

    P -->|"Necessita orçamento"| PC

    PC -->|"Evento:<br/>CotacoesRecebidas"| P

    P -->|"Evento:<br/>PropostaSubmetida"| WAIT["⏳ Aguarda resultado"]

    WAIT -->|"Evento:<br/>PropostaAdjudicada"| O

    O -->|"NecessidadeMaterialIdentificada"| S

    S -->|"Stock insuficiente"| PC

    PC -->|"Evento:<br/>FornecedorSelecionado"| O

    O -->|"Criar planeamento"| CR

    O -->|"Alocar equipa"| AF

    CR -->|"Tarefas executadas"| O
    AF -->|"Recursos atribuídos"| O

    O -->|"Evento:<br/>ObraConcluida"| G


    %% =========================
    %% SISTEMAS EXTERNOS
    %% =========================

    DR["🌐 Diário da República"]
    BASE["🌐 Portal BASE"]
    PLAT["🌐 Plataforma de propostas"]
    SAGE["🖥️ SAGE"]
    EXCEL["📊 Excel"]
    EMAIL["✉️ Email"]

    DR -. "origem dos concursos" .-> C

    EMAIL -. "aviso de convite" .-> C

    PLAT -. "documentos / submissão" .-> P

    BASE -. "consulta de adjudicação" .-> C

    SAGE -. "dados administrativos da obra" .-> O

    EXCEL -. "gestão detalhada" .-> O